# Everything derived from the disc image stays out of version control -- the
# repo holds the tooling and the configuration that regenerates it.
.venv/
build/
disc/
iso/
asm/
assets/
config/disc.xml
undefined_syms_auto.txt
undefined_funcs_auto.txt

# Vendored proprietary/binary toolchain: mipsel-none-elf binutils, mkpsxiso and
# the Psy-Q SDK.  Supply your own -- see the README.
tools/bin/

# tools/maspsx, tools/asm-differ and tools/m2c are git submodules, not ignores.

__pycache__/
*.pyc
mkpsxiso.cue

# Reference material and large third-party checkouts: downloadable, not ours to
# redistribute, and a 12.9 MB tarball has no business in git history.
tools/ref/
tools/bin/redux/
debug_source.c
debug_compiled_object.o
