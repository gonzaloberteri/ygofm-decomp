.venv/
build/
disc/
iso/
asm/
assets/
config/disc.xml
undefined_syms_auto.txt
undefined_funcs_auto.txt

# Vendored proprietary/binary toolchain: mipsel-none-elf binutils, mkpsxiso and
# the Psy-Q SDK.  Supply your own -- see the README.
tools/bin/

# tools/maspsx, tools/asm-differ and tools/m2c are git submodules, not ignores.

__pycache__/
*.pyc
mkpsxiso.cue
